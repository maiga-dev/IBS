<script>

document.addEventListener('DOMContentLoaded', function () {

    const dropdown =
        document.getElementById('ibsSettingsDropdown');

    const trigger =
        document.getElementById('ibsSettingsTrigger');

    if (!dropdown || !trigger) {
        return;
    }

    const submenuTriggers =
        dropdown.querySelectorAll('.ibs-submenu-trigger');


    /* Ferme tous les sous-menus. */
    function closeSubmenus() {

        submenuTriggers.forEach(function (item) {

            item.setAttribute('aria-expanded', 'false');

            const parent =
                item.closest('.ibs-settings-submenu');

            if (parent) {
                parent.classList.remove('is-open');
            }

        });

    }


    /* Ouvre le menu Paramètres. */
    function openMenu() {

        dropdown.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');

    }


    /* Ferme le menu Paramètres et ses sous-menus. */
    function closeMenu() {

        dropdown.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');

        closeSubmenus();

    }


    /* Clic sur Paramètres. */
    trigger.addEventListener('click', function (event) {

        event.preventDefault();
        event.stopPropagation();

        if (dropdown.classList.contains('is-open')) {
            closeMenu();
        } else {
            openMenu();
        }

    });


    /* Navigation clavier. */
    trigger.addEventListener('keydown', function (event) {

        if (event.key === 'Enter' || event.key === ' ') {

            event.preventDefault();
            trigger.click();

        }

    });


    /* Gestion des sous-menus. */
    submenuTriggers.forEach(function (item) {

        item.addEventListener('click', function (event) {

            event.preventDefault();
            event.stopPropagation();

            const parent =
                item.closest('.ibs-settings-submenu');

            if (!parent) {
                return;
            }

            const isOpen =
                parent.classList.contains('is-open');

            /* Ferme les autres sous-menus. */
            submenuTriggers.forEach(function (otherItem) {

                const otherParent =
                    otherItem.closest('.ibs-settings-submenu');

                if (otherParent && otherParent !== parent) {

                    otherParent.classList.remove('is-open');
                    otherItem.setAttribute('aria-expanded', 'false');

                }

            });

            /* Ouvre ou ferme le sous-menu sélectionné. */
            if (isOpen) {

                parent.classList.remove('is-open');
                item.setAttribute('aria-expanded', 'false');

            } else {

                parent.classList.add('is-open');
                item.setAttribute('aria-expanded', 'true');

            }

        });

        item.addEventListener('keydown', function (event) {

            if (event.key === 'Enter' || event.key === ' ') {

                event.preventDefault();
                item.click();

            }

        });

    });

  
});

</script>

