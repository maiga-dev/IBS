<!-- =========================================================
     MENU TÉLÉPHONE : ouverture / fermeture avec les 3 traits
========================================================== -->

<script>

document.addEventListener('DOMContentLoaded', function () {

    const button  = document.getElementById('ibsMenuButton');
    const sidebar = document.getElementById('ibsSidebar');

    if (!button || !sidebar) {
        return;
    }

    function setOpen(open) {

        sidebar.classList.toggle('open', open);
        document.body.classList.toggle('menu-open', open);

        button.setAttribute('aria-expanded', open ? 'true' : 'false');
        button.setAttribute(
            'aria-label',
            open ? 'Fermer le menu' : 'Ouvrir le menu'
        );

    }

    button.addEventListener('click', function (event) {

        event.stopPropagation();

        setOpen(!sidebar.classList.contains('open'));

    });

    /* Un appui à côté du menu (sur le fond sombre) le referme. */
    document.addEventListener('click', function (event) {

        if (
            sidebar.classList.contains('open') &&
            !sidebar.contains(event.target) &&
            !button.contains(event.target)
        ) {
            setOpen(false);
        }

    });

    /* Touche Échap : fermeture. */
    document.addEventListener('keydown', function (event) {

        if (event.key === 'Escape') {
            setOpen(false);
        }

    });

    /* Repasse en affichage normal si l'écran s'agrandit. */
    window.addEventListener('resize', function () {

        if (window.innerWidth > 900) {
            setOpen(false);
        }

    });

});

</script>


