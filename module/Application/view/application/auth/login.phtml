<?php
/** @var Laminas\View\Renderer\PhpRenderer $this */
$erreur = $erreur ?? null;
$email  = $email ?? '';
?>

<h1>Connexion</h1>
<p class="subtitle">Accédez à votre espace IBS Pulse.</p>

<?php if ($erreur): ?>
    <div class="auth-error"><?= $this->escapeHtml($erreur) ?></div>
<?php endif; ?>

<form method="post" action="<?= $this->url('auth', ['action' => 'login']) ?>">

    <div class="auth-field">
        <label for="email">Email</label>
        <input
            type="email"
            id="email"
            name="email"
            value="<?= $this->escapeHtmlAttr($email) ?>"
            required
            autofocus
        >
    </div>

    <div class="auth-field">
        <label for="mot_de_passe">Mot de passe</label>
        <input
            type="password"
            id="mot_de_passe"
            name="mot_de_passe"
            required
        >
    </div>

    <button type="submit" class="auth-submit">Se connecter</button>

</form>

<div class="auth-switch">
    Pas encore de compte ?
    <a href="<?= $this->url('auth', ['action' => 'register']) ?>">Créer un compte</a>
</div>
