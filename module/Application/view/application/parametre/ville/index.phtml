<?php
/** @var Laminas\View\Renderer\PhpRenderer $this */
$villes = $villes ?? [];
?>
<div class="dashboard">
    <div class="dashboard-title">
        <div>
            <h1>Villes</h1>
            <p>Villes rattachées à un pays.</p>
        </div>
        <a href="<?= $this->url('ville', ['action' => 'add']) ?>" class="auth-submit" style="width:auto;padding:10px 18px;text-decoration:none;display:inline-block;">
