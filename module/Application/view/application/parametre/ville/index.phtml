                <strong>Aucune ville enregistrée</strong>
            </div>
        <?php else: ?>
            <div class="table-wrapper">
                <table class="ibs-table">
                    <thead><tr><th>Nom</th><th>Pays</th><th></th></tr></thead>
                    <tbody>
                    <?php foreach ($villes as $v): ?>
                        <tr>
                            <td><?= $this->escapeHtml($v['nom_ville']) ?></td>
                            <td><?= $this->escapeHtml((string) ($v['nom_pays'] ?? '—')) ?></td>
                            <td style="text-align:right;">
                                <a href="<?= $this->url('ville', ['action' => 'edit', 'id' => $v['id_ville']]) ?>">Modifier</a>
                                &nbsp;·&nbsp;
                                <a href="<?= $this->url('ville', ['action' => 'delete', 'id' => $v['id_ville']]) ?>"
