<?php
/** @var Laminas\View\Renderer\PhpRenderer $this */

$erreur = $erreur ?? null;

$item = $item ?? [
    'nom_ville' => '',
    'id_pays'   => null,
];

$paysListe = $paysListe ?? [];

$mode = $mode ?? 'ajout';

$action = $mode === 'modification'
    ? $this->url('ville', [
        'action' => 'edit',
        'id' => $item['id_ville'] ?? null,
    ])
    : $this->url('ville', [
        'action' => 'add',
    ]);
?>

<div class="dashboard">

    <div class="dashboard-title">
        <div>

           

            <h1>
                <?= $mode === 'modification'
                    ? 'Modifier la ville'
                    : 'Ajouter une ville'
                ?>
            </h1>

            <p>
                <?= $mode === 'modification'
                    ? 'Modifiez la ville et son pays de rattachement.'
                    : 'Sélectionnez le pays puis renseignez la ville.'
                ?>
            </p>

        </div>
    </div>


    <div class="dashboard-panel form-panel">

        <div class="form-card">

            <div class="form-card-header">

              

                <div>
                    <h4>Localisation</h4>
                </div>

            </div>


            <?php if ($erreur): ?>

                <div class="auth-error form-error">
                    <?= $this->escapeHtml($erreur) ?>
                </div>

            <?php endif; ?>


            <form
                method="post"
                action="<?= $action ?>"
                class="ibs-form"
            >

                <div class="auth-field">

                    <label for="id_pays">
                        Pays
                    </label>

                    <select
                        id="id_pays"
                        name="id_pays"
                        required
                        autofocus
                    >

                        <option value="">
                            Sélectionner un pays
                        </option>

                        <?php foreach ($paysListe as $p): ?>

                            <option
                                value="<?= $this->escapeHtmlAttr(
                                    (string) $p['id_pays']
                                ) ?>"
                                <?= (string) ($item['id_pays'] ?? '') ===
                                    (string) $p['id_pays']
                                    ? 'selected'
                                    : ''
                                ?>
                            >
                                <?= $this->escapeHtml(
                                    (string) $p['nom_pays']
                                ) ?>
                            </option>

                        <?php endforeach; ?>

                    </select>

                    <small class="form-help">
                        Sélectionnez le pays auquel appartient cette ville.
                    </small>

                </div>


                <div class="auth-field">

                    <label for="nom_ville">
                        Nom de la ville
                    </label>

                    <input
                        type="text"
                        id="nom_ville"
                        name="nom_ville"
                        value="<?= $this->escapeHtmlAttr(
                            (string) ($item['nom_ville'] ?? '')
                        ) ?>"
                        placeholder="Ex. Ouagadougou"
                        required
                    >

                </div>


                <div class="form-actions">
                     <a
                        href="<?= $this->url('ville') ?>"
                        class="form-cancel-button"
                    >
                        Retour
                    </a>
                    <a
                        href="<?= $this->url('ville') ?>"
                        class="form-cancel-button"
                    >
                        Annuler
                    </a>

                    <button
                        type="submit"
                        class="auth-submit form-submit-button"
                    >
                        <?= $mode === 'modification'
                            ? 'Enregistrer les modifications'
                            : 'Enregistrer la ville'
                        ?>
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>