<?php

declare(strict_types=1);

/**
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var array $equipement
 * @var array $maintenances
 */

$equipement = $equipement ?? [];

$maintenances = $maintenances ?? [];

$idEquipement = (int) (
    $equipement['id_equipement'] ?? 0
);

$designation = trim(
    (string) (
        $equipement['designation'] ?? ''
    )
);

if ($designation === '') {
    $designation = 'Équipement biomédical';
}

$numeroSerie = trim(
    (string) (
        $equipement['numero_serie'] ?? ''
    )
);

$nombreInterventions = count(
    $maintenances
);

?>

<div class="dashboard equipment-history-page">

    <!-- =====================================================
         EN-TÊTE
         ===================================================== -->

    <div class="dashboard-header">

        <div>

            


            <h1>
                Historique de maintenance
            </h1>

            <p>

                Équipement n° <?= $idEquipement ?> :
                <?= $this->escapeHtml(
                    $designation
                ) ?>

                <?php if ($numeroSerie !== ''): ?>

                    <span class="maintenance-history-serial">
                        · N° série :
                        <?= $this->escapeHtml(
                            $numeroSerie
                        ) ?>
                    </span>

                <?php endif; ?>

            </p>

        </div>

    </div>


    <!-- =====================================================
         RESUME
         ===================================================== -->

    <div class="dashboard-panel">

        <div class="maintenance-history-summary">

            <div>

                <h2>
                    Interventions
                </h2>

                <p>
                    Suivi des opérations réalisées sur
                    cet équipement.
                </p>

            </div>


            <div class="maintenance-history-count">
                <?= $nombreInterventions ?>
                intervention<?= $nombreInterventions > 1
                    ? 's'
                    : '' ?>
            </div>

        </div>

    </div>


    <!-- =====================================================
         HISTORIQUE
         ===================================================== -->

    <div class="dashboard-panel">

        <?php if (empty($maintenances)): ?>

            <div class="empty-dashboard">

                <div class="empty-dashboard-icon">
                    ✓
                </div>

                <strong>
                    Aucun historique
                </strong>

                <p class="maintenance-history-empty-text">
                    Aucune intervention n'est encore
                    enregistrée pour cet équipement.
                </p>

            </div>

        <?php else: ?>

            <div class="table-responsive">

                <table class="ibs-table maintenance-history-table">

                    <thead>

                        <tr>

                            <th>
                                Date
                            </th>

                            <th>
                                Type
                            </th>

                            <th>
                                Technicien
                            </th>

                            <th>
                                Diagnostic
                            </th>

                            <th>
                                Compte rendu
                            </th>

                            <th>
                                Statut
                            </th>

                            <th>
                                Fin
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                    <?php foreach (
                        $maintenances
                        as $maintenance
                    ): ?>

                        <?php

                        $statutBrut = trim(
                            (string) (
                                $maintenance[
                                    'statut'
                                ] ?? ''
                            )
                        );

                        $statut = strtolower(
                            $statutBrut
                        );

                        $classeStatut =
                            'status-neutral';

                        $statutAffiche =
                            $statutBrut !== ''
                                ? $statutBrut
                                : '—';

                        if (
                            $statut === 'terminee'
                            || $statut === 'terminée'
                        ) {

                            $classeStatut =
                                'status-success';

                            $statutAffiche =
                                'Terminée';

                        } elseif (
                            $statut === 'en_cours'
                            || $statut === 'en cours'
                        ) {

                            $classeStatut =
                                'status-warning';

                            $statutAffiche =
                                'En cours';

                        }


                        $technicien = trim(
                            (string) (
                                (
                                    $maintenance[
                                        'technicien_prenom'
                                    ] ?? ''
                                )
                                . ' '
                                .
                                (
                                    $maintenance[
                                        'technicien_nom'
                                    ] ?? ''
                                )
                            )
                        );


                        $diagnostic = trim(
                            (string) (
                                $maintenance[
                                    'diagnostic'
                                ] ?? ''
                            )
                        );


                        $compteRendu = trim(
                            (string) (
                                $maintenance[
                                    'compte_rendu'
                                ] ?? ''
                            )
                        );

                        ?>

                        <tr>

                            <!-- DATE -->

                            <td>

                                <?php if (
                                    !empty(
                                        $maintenance[
                                            'date_maintenance'
                                        ]
                                    )
                                ): ?>

                                    <?=
                                    $this->escapeHtml(
                                        date(
                                            'd/m/Y',
                                            strtotime(
                                                (string)
                                                $maintenance[
                                                    'date_maintenance'
                                                ]
                                            )
                                        )
                                    )
                                    ?>

                                <?php else: ?>

                                    —

                                <?php endif; ?>

                            </td>


                            <!-- TYPE -->

                            <td>

                                <?= $this->escapeHtml(
                                    $maintenance[
                                        'type_maintenance'
                                    ] ?? '—'
                                ) ?>

                            </td>


                            <!-- TECHNICIEN -->

                            <td>

                                <?= $this->escapeHtml(
                                    $technicien !== ''
                                        ? $technicien
                                        : 'Non affecté'
                                ) ?>

                            </td>


                            <!-- DIAGNOSTIC -->

                            <td>

                                <?php if (
                                    $diagnostic !== ''
                                ): ?>

                                    <div class="maintenance-history-text">
                                        <?= $this->escapeHtml(
                                            $diagnostic
                                        ) ?>
                                    </div>

                                <?php else: ?>

                                    —

                                <?php endif; ?>

                            </td>


                            <!-- COMPTE RENDU -->

                            <td>

                                <?php if (
                                    $compteRendu !== ''
                                ): ?>

                                    <div class="maintenance-history-text">

                                        <?= $this->escapeHtml(
                                            $compteRendu
                                        ) ?>

                                    </div>

                                <?php else: ?>

                                    <span class="maintenance-history-text is-empty">
                                        Aucun compte rendu
                                    </span>

                                <?php endif; ?>

                            </td>


                            <!-- STATUT -->

                            <td>

                                <span
                                    class="status-badge
                                    <?= $classeStatut ?>"
                                >

                                    <span
                                        class="status-dot"
                                    ></span>

                                    <?= $this->escapeHtml(
                                        $statutAffiche
                                    ) ?>

                                </span>

                            </td>


                            <!-- FIN -->

                            <td>

                                <?php if (
                                    !empty(
                                        $maintenance[
                                            'date_fin'
                                        ]
                                    )
                                ): ?>

                                    <?=
                                    $this->escapeHtml(
                                        date(
                                            'd/m/Y',
                                            strtotime(
                                                (string)
                                                $maintenance[
                                                    'date_fin'
                                                ]
                                            )
                                        )
                                    )
                                    ?>

                                <?php else: ?>

                                    —

                                <?php endif; ?>

                            </td>

                        </tr>

                    <?php endforeach; ?>

                    </tbody>

                </table>

            </div>

        <?php endif; ?>

    </div>


    <!-- =====================================================
         RETOUR
         ===================================================== -->

    <div class="dashboard-panel">

        <div class="form-actions">

            <a
                href="<?= $this->url(
                    'equipement',
                    [
                        'action' => 'view',
                        'id' => $idEquipement,
                    ]
                ) ?>"
                class="btn-secondary"
            >
                Retour à l'équipement
            </a>

        </div>

    </div>

</div>

