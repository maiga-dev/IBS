<script>
document.addEventListener('DOMContentLoaded', function () {

    const searchInput = document.getElementById('equipementSearch');
    const table = document.getElementById('tableEquipements');
    const message = document.getElementById('equipementSearchMessage');
    const noResult = document.getElementById('equipementNoResult');

    if (!searchInput || !table) {
        return;
    }

    const rows = Array.from(
        table.querySelectorAll('tbody tr')
    );

    function normaliser(texte) {
        return String(texte || '')
            .toLocaleLowerCase('fr-FR')
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '');
    }

    function rechercher() {

        const recherche = normaliser(
            searchInput.value.trim()
        );

        let nombreVisible = 0;

        rows.forEach(function (row) {

            const contenu = normaliser(
                row.textContent
            );

            const visible =
                recherche === ''
                || contenu.includes(recherche);

            row.style.display = visible ? '' : 'none';

            if (visible) {
                nombreVisible++;
            }
        });

        if (noResult) {
            noResult.style.display =
                nombreVisible === 0 ? 'flex' : 'none';
        }

        if (message) {
            message.textContent =
                recherche === ''
                    ? 'La recherche porte sur toutes les informations affichées.'
                    : nombreVisible + ' équipement(s) correspondant(s).';
        }
    }

    searchInput.addEventListener('input', rechercher);
});
</script>
