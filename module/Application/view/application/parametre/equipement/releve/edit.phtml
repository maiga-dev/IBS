<?php

declare(strict_types=1);

/**
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var array $equipement
 * @var array $postData
 * @var string|null $error
 * @var int $idEquipement
 * @var int $idReleve
 */

$equipement = $equipement ?? [];
$postData = $postData ?? [];
$error = $error ?? null;

$idEquipement = (int) ($idEquipement ?? 0);
$idReleve = (int) ($idReleve ?? 0);

$designation = trim(
    (string) ($equipement['designation'] ?? '')
);

$designation = $designation !== ''
    ? $designation
    : 'Équipement biomédical';

?>

<div class="dashboard">

    <div class="dashboard-title">

        <div>

          

            <h1>
                Modifier le relevé
            </h1>

            <p>
                <?= $this->escapeHtml($designation) ?>
            </p>

        </div>

    </div>


    <?php if ($error): ?>

        <div class="alert alert-danger">
            <?= $this->escapeHtml($error) ?>
        </div>

    <?php endif; ?>


    <div class="dashboard-panel form-panel form-panel-wide">

        <form
            method="post"
            action="<?= $this->url(
                'releve',
                [
                    'id'     => $idEquipement,
                    'action' => 'edit',
                    'releve' => $idReleve,
                ]
            ) ?>"
        >

            <div class="form-card">

                <div class="form-section">

                    <div class="form-section-header">

                        <div>

                            <h2>
                                Informations du relevé
                            </h2>

                            <p>
                                Modifier les mesures enregistrées.
                            </p>

                        </div>

                    </div>


                    <div class="auth-row">

                        <div class="auth-field">

                            <label for="date_releve">
                                Date et heure du relevé
