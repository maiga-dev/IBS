                                name="date_releve"
                                id="date_releve"
                                class="form-input"
                                value="<?= $this->escapeHtmlAttr(
                                    (string) (
                                        $postData['date_releve']
                                        ?? ''
                                    )
                                ) ?>"
                                required
                            >

                        </div>


                        <div class="auth-field">

                            <label for="heure_total">
                                Heures total
                            </label>

                            <input
                                type="number"
                                step="0.01"
                                min="0"
                                name="heure_total"
                                id="heure_total"
                                class="form-input"
                                value="<?= $this->escapeHtmlAttr(
                                    (string) (
                                        $postData['heure_total']
                                        ?? ''
                                    )
                                ) ?>"
                            >

                        </div>

                    </div>


                    <div class="auth-row">

                        <div class="auth-field">

                            <label for="heure_production">
                                Heures de production
                            </label>

                            <input
                                type="number"
                                step="0.01"
                                min="0"
                                name="heure_production"
                                id="heure_production"
                                class="form-input"
                                value="<?= $this->escapeHtmlAttr(
                                    (string) (
                                        $postData['heure_production']
                                        ?? ''
                                    )
                                ) ?>"
                            >

                        </div>


                        <div class="auth-field">

                            <label for="pression">
                                Pression
                            </label>

                            <input
                                type="number"
                                step="0.01"
                                name="pression"
                                id="pression"
                                class="form-input"
                                value="<?= $this->escapeHtmlAttr(
                                    (string) (
                                        $postData['pression']
                                        ?? ''
                                    )
                                ) ?>"
                            >

                        </div>

                    </div>


                    <div class="auth-row">

                        <div class="auth-field">

                            <label for="purete">
                                Pureté
                            </label>

                            <input
                                type="number"
                                step="0.01"
                                min="0"
                                max="100"
                                name="purete"
                                id="purete"
                                class="form-input"
                                value="<?= $this->escapeHtmlAttr(
                                    (string) (
                                        $postData['purete']
                                        ?? ''
                                    )
                                ) ?>"
