                        </div>

                    </div>


                    <div class="auth-row">

                        <div class="auth-field">

                            <label for="heure_production">
                                Heures production
                            </label>

                            <input
                                type="number"
                                id="heure_production"
                                name="heure_production"
                                class="form-control form-input"
                                step="0.01"
                                min="0"
                                value="<?= $this->escapeHtmlAttr(
                                    (string) (
                                        $postData['heure_production'] ?? ''
                                    )
                                ) ?>"
