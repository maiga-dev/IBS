            </a>

            <h1>Ajouter un relevé</h1>

            <p>
                <?= $this->escapeHtml($designation) ?>
            </p>

        </div>

    </div>


    <div class="dashboard-panel form-panel form-panel-wide">

        <?php if ($error !== null): ?>

            <div class="alert alert-danger">
                <?= $this->escapeHtml($error) ?>
            </div>

        <?php endif; ?>


        <form
            method="post"
            action="<?= $this->url(
