                                value="<?= $this->escapeHtmlAttr(
                                    (string) (
                                        $postData['date_releve'] ?? ''
                                    )
                                ) ?>"
                                required
                            >

                        </div>

                        <div class="auth-field">

                            <label for="heure_total">
                                Heures total
