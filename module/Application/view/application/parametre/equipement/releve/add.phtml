<?php

declare(strict_types=1);

/**
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var array $equipement
 * @var array $postData
 * @var int $idEquipement
 * @var string|null $error
 */

$equipement = $equipement ?? [];
$postData = $postData ?? [];
$idEquipement = (int) ($idEquipement ?? 0);
$error = $error ?? null;

$designation = trim(
    (string) ($equipement['designation'] ?? '')
);

$designation = $designation !== ''
    ? $designation
    : 'Équipement biomédical';

?>

<div class="dashboard">

    <div class="dashboard-title">

        <div>

            <a
                href="<?= $this->url(
                    'releve',
