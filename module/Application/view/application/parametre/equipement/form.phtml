<script>

document.addEventListener('DOMContentLoaded', function () {

    const familleSelect =
        document.getElementById('id_famille');

    const centraleSelect =
        document.getElementById('id_centrale');

    if (!familleSelect || !centraleSelect) {
        return;
    }

    function filtrerCentrales() {

        const familleId =
            String(familleSelect.value || '').trim();

        Array.from(centraleSelect.options).forEach(function (option) {

            if (option.value === '') {
                option.hidden = false;
                return;
            }

            const optionFamille =
                String(
                    option.getAttribute('data-famille') || ''
                ).trim();

            /*
             * Aucune famille sélectionnée :
             * on affiche toutes les centrales.
             */
            if (familleId === '') {
                option.hidden = false;
                return;
            }

            /*
             * Famille sélectionnée :
             * on affiche uniquement les centrales
             * appartenant à cette famille.
             */
            option.hidden =
                optionFamille !== familleId;
        });

        /*
         * Si la centrale actuellement sélectionnée
         * ne correspond plus à la famille choisie,
         * on la remet à vide.
         */
        const selectedOption =
            centraleSelect.options[
                centraleSelect.selectedIndex
            ];

        if (
            selectedOption &&
            selectedOption.value !== '' &&
            selectedOption.hidden
        ) {
            centraleSelect.value = '';
        }
    }

    familleSelect.addEventListener(
        'change',
        filtrerCentrales
    );

    filtrerCentrales();
});
</script>