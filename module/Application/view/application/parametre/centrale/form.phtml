<?php

declare(strict_types=1);

/**
 * @var Laminas\View\Renderer\PhpRenderer $this
 */

$erreur = $erreur ?? null;

$item = $item ?? [
    'type_centrale' => '',
    'id_famille'    => null,
];

$familles = $familles ?? [];

$mode = $mode ?? 'ajout';

$action = $mode === 'modification'
    ? $this->url('centrale', [
        'action' => 'edit',
        'id'     => $item['id_centrale'] ?? null,
    ])
    : $this->url('centrale', [
        'action' => 'add',
    ]);

?>

<div class="dashboard">

    <div class="dashboard-title">

        <div>

            <h1>
                <?= $mode === 'modification'
                    ? 'Modifier le type'
                    : 'Ajouter le type'
                ?>
            </h1>

            <p>
                Créez une centrale en renseignant son type
                d'équipement et sa famille.
            </p>

        </div>

    </div>


    <div class="dashboard-panel form-panel">

        <div class="form-card">

            <div class="form-card-header">

               
                <div>

                    <h4>
                        Informations du type d'équipement
                    </h4>

                   
                </div>

            </div>


            <?php if ($erreur): ?>

                <div class="auth-error form-error">

                    <?= $this->escapeHtml($erreur) ?>

                </div>

            <?php endif; ?>


            <form
                method="post"
                action="<?= $action ?>"
                class="ibs-form"
            >

                <!-- FAMILLE -->

                <div class="auth-field">

                    <label for="id_famille">
                        Famille
                    </label>

                    <select
                        id="id_famille"
                        name="id_famille"
                        autofocus
                    >

                        <option value="">
                            Sélectionner une famille
                        </option>

                        <?php foreach ($familles as $famille): ?>

                            <option
                                value="<?= $this->escapeHtmlAttr(
                                    (string) $famille['id_famille']
                                ) ?>"
                                <?= (string) (
                                    $item['id_famille'] ?? ''
                                ) === (string) (
                                    $famille['id_famille']
                                )
                                    ? 'selected'
                                    : ''
                                ?>
                            >

                                <?= $this->escapeHtml(
                                    (string) $famille['nom_famille']
                                ) ?>

                            </option>

                        <?php endforeach; ?>

                    </select>

                </div>


                <!-- TYPE DE CENTRALE -->

                <div class="auth-field">

                    <label for="type_centrale">
                        Type d'équipement
                    </label>

                    <input
                        type="text"
                        id="type_centrale"
                        name="type_centrale"
                        value="<?= $this->escapeHtmlAttr(
                            (string) (
                                $item['type_centrale'] ?? ''
                            )
                        ) ?>"
                        placeholder="Ex. Centrale d’oxygène"
                        required
                    >

                </div>


                <!-- ACTIONS -->

                <div class="form-actions">

                    <a
                        href="<?= $this->url('centrale') ?>"
                        class="form-cancel-button"
                    >
                        Annuler
                    </a>

                    <button
                        type="submit"
                        class="auth-submit form-submit-button"
                    >

                        <?= $mode === 'modification'
                            ? 'Enregistrer les modifications'
                            : 'Enregistrer la centrale'
                        ?>

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>