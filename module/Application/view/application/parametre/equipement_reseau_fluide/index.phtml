<?php if (!empty($equipements)): ?>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const input = document.getElementById('searchReseaux');
    const rows = Array.from(
        document.querySelectorAll('#tableReseaux tbody tr')
    );

    function normaliser(texte) {
        return String(texte || '')
            .toLocaleLowerCase('fr-FR')
            .normalize('NFD')
            .replace(/[̀-ͯ]/g, '');
    }

    input.addEventListener('input', function () {
        const recherche = normaliser(input.value.trim());

        rows.forEach(function (row) {
            const contenu = normaliser(row.textContent);
            row.style.display =
                recherche === '' || contenu.includes(recherche)
                    ? ''
                    : 'none';
        });
    });
});
</script>
