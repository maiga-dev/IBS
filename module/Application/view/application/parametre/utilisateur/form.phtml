<?php
/** @var Laminas\View\Renderer\PhpRenderer $this */

$erreur = $erreur ?? null;

$item = $item ?? [
    'nom'       => '',
    'prenom'    => '',
    'telephone' => '',
    'email'     => '',
    'role'      => 'technicien',
];

$roles = $roles ?? [];

$mode = $mode ?? 'ajout';

$action = $mode === 'modification'
    ? $this->url('utilisateur', [
        'action' => 'edit',
        'id' => $item['id'] ?? null,
    ])
    : $this->url('utilisateur', [
        'action' => 'add',
    ]);
?>

<div class="dashboard">

    <div class="dashboard-title">
        <div>


            <h1>
                <?= $mode === 'modification'
                    ? 'Modifier l’utilisateur'
                    : 'Ajouter un utilisateur'
                ?>
            </h1>

            <p>
                <?= $mode === 'modification'
                    ? 'Modifiez les informations du compte.'
                    : 'Créez un nouveau compte utilisateur IBS.'
                ?>
            </p>

        </div>
    </div>


    <div class="dashboard-panel form-panel form-panel-user">

        <div class="form-card">

            <div class="form-card-header">

                <div class="form-card-icon">
                    
                </div>

                <div>
                    <h4>Informations de l’utilisateur</h4>
                  
                </div>

            </div>


            <?php if ($erreur): ?>

                <div class="auth-error form-error">
                    <?= $this->escapeHtml($erreur) ?>
                </div>

            <?php endif; ?>


            <form
                method="post"
                action="<?= $action ?>"
                class="ibs-form"
            >

                <div class="auth-row">

                    <div class="auth-field">

                        <label for="prenom">
                            Prénom
                        </label>

                        <input
                            type="text"
                            id="prenom"
                            name="prenom"
                            value="<?= $this->escapeHtmlAttr(
                                (string) ($item['prenom'] ?? '')
                            ) ?>"
                            placeholder="Prénom"
                            autocomplete="given-name"
                            required
                            autofocus
                        >

                    </div>


                    <div class="auth-field">

                        <label for="nom">
                            Nom
                        </label>

                        <input
                            type="text"
                            id="nom"
                            name="nom"
                            value="<?= $this->escapeHtmlAttr(
                                (string) ($item['nom'] ?? '')
                            ) ?>"
                            placeholder="Nom"
                            autocomplete="family-name"
                            required
                        >

                    </div>

                </div>


                <div class="auth-field">

                    <label for="email">
                        Adresse e-mail
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        value="<?= $this->escapeHtmlAttr(
                            (string) ($item['email'] ?? '')
                        ) ?>"
                        placeholder="exemple@ibs.com"
                        autocomplete="email"
                        required
                    >

                </div>


                <div class="auth-field">

                    <label for="telephone">
                        Téléphone
                    </label>

                    <input
                        type="tel"
                        id="telephone"
                        name="telephone"
                        value="<?= $this->escapeHtmlAttr(
                            (string) ($item['telephone'] ?? '')
                        ) ?>"
                        placeholder="+226 70 00 00 00"
                        autocomplete="tel"
                    >

                </div>


                <div class="auth-field">

                    <label for="role">
                        Rôle
                    </label>

                    <select
                        id="role"
                        name="role"
                        required
                    >

                        <?php if (!empty($roles)): ?>

                            <?php foreach ($roles as $role): ?>

                                <?php
                                if (is_array($role)) {
                                    $value =
                                        $role['value']
                                        ?? $role['role']
                                        ?? '';

                                    $label =
                                        $role['label']
                                        ?? ucfirst($value);
                                } else {
                                    $value = (string) $role;
                                    $label = ucfirst($value);
                                }
                                ?>

                                <option
                                    value="<?= $this->escapeHtmlAttr(
                                        $value
                                    ) ?>"
                                    <?= (string) (
                                        $item['role'] ?? ''
                                    ) === $value
                                        ? 'selected'
                                        : ''
                                    ?>
                                >
                                    <?= $this->escapeHtml($label) ?>
                                </option>

                            <?php endforeach; ?>

                        <?php else: ?>

                            <option
                                value="technicien"
                                <?= ($item['role'] ?? '') === 'technicien'
                                    ? 'selected'
                                    : ''
                                ?>
                            >
                                Technicien
                            </option>

                            <option
                                value="admin"
                                <?= ($item['role'] ?? '') === 'admin'
                                    ? 'selected'
                                    : ''
                                ?>
                            >
                                Administrateur
                            </option>

                        <?php endif; ?>

                    </select>

                </div>


                <div class="auth-field">

                    <label for="mot_de_passe">
                        Mot de passe
                    </label>

                    <input
                        type="password"
                        id="mot_de_passe"
                        name="mot_de_passe"
                        placeholder="<?= $mode === 'modification'
                            ? 'Laisser vide pour conserver le mot de passe'
                            : 'Créer un mot de passe'
                        ?>"
                        autocomplete="new-password"
                        <?= $mode === 'ajout'
                            ? 'required'
                            : ''
                        ?>
                    >

                    <?php if ($mode === 'modification'): ?>

                        <small class="form-help">
                            Laissez ce champ vide si vous ne souhaitez pas
                            modifier le mot de passe.
                        </small>

                    <?php endif; ?>

                </div>


                <div class="form-actions">

                     

                    <a
                        href="<?= $this->url('utilisateur') ?>"
                        class="form-cancel-button"
                    >
                        Annuler
                    </a>

                    <button
                        type="submit"
                        class="auth-submit form-submit-button"
                    >
                        <?= $mode === 'modification'
                            ? 'Enregistrer les modifications'
                            : 'Créer l’utilisateur'
                        ?>
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>