<?php
/** @var Laminas\View\Renderer\PhpRenderer $this */

$utilisateurs = $utilisateurs ?? [];

/*
 * Préparation des utilisateurs pour la recherche dans le champ Actions.
 * Les URLs sont générées côté PHP afin de respecter les routes Laminas.
 */
$utilisateursActions = [];

foreach ($utilisateurs as $u) {

    $nomComplet = trim(
        ($u['prenom'] ?? '') . ' ' . ($u['nom'] ?? '')
    );

    $utilisateursActions[] = [
        'id' => (string) ($u['id'] ?? ''),
        'nom' => $nomComplet,
        'email' => (string) ($u['email'] ?? ''),
        'modifier' => $this->url(
            'utilisateur',
            [
                'action' => 'edit',
                'id' => $u['id']
            ]
        ),
        'supprimer' => $this->url(
            'utilisateur',
            [
                'action' => 'delete',
                'id' => $u['id']
            ]
        )
    ];
}
