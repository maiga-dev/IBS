<?php if (!empty($utilisateursActions)): ?>

<script>
document.addEventListener('DOMContentLoaded', function () {

    const utilisateurs =
        <?= json_encode(
            $utilisateursActions,
            JSON_HEX_TAG |
            JSON_HEX_APOS |
            JSON_HEX_QUOT |
            JSON_HEX_AMP
        ) ?>;

    const searchInput =
        document.getElementById('actionUserSearch');

    const editButton =
        document.getElementById('actionEditUser');

    const deleteButton =
        document.getElementById('actionDeleteUser');

    const message =
        document.getElementById('actionUserMessage');


    /*
     * Désactive les boutons d'action.
     */
    function desactiverActions() {

        editButton.href = '#';
        deleteButton.href = '#';

        editButton.classList.add('disabled');
        deleteButton.classList.add('disabled');

        editButton.setAttribute(
            'aria-disabled',
            'true'
        );

        deleteButton.setAttribute(
            'aria-disabled',
            'true'
        );
    }


    /*
     * Active les boutons pour l'utilisateur sélectionné.
     */
    function activerActions(utilisateur) {

        editButton.href = utilisateur.modifier;
        deleteButton.href = utilisateur.supprimer;

        editButton.classList.remove('disabled');
        deleteButton.classList.remove('disabled');

        editButton.setAttribute(
            'aria-disabled',
            'false'
        );

        deleteButton.setAttribute(
            'aria-disabled',
            'false'
        );

        message.textContent =
            'Utilisateur sélectionné : ' +
            utilisateur.nom;
    }


    /*
     * Recherche par nom, prénom ou email.
     */
    function rechercherUtilisateur() {

        const recherche =
            searchInput.value
                .toLowerCase()
                .trim();

        if (recherche === '') {

            desactiverActions();

            message.textContent =
                'Saisissez ou sélectionnez un utilisateur pour afficher les actions.';

            return;
        }


        const utilisateur =
            utilisateurs.find(function (user) {

                const nom =
                    (user.nom || '').toLowerCase();

                const email =
                    (user.email || '').toLowerCase();

                return (
                    nom === recherche ||
                    nom.includes(recherche) ||
                    email.includes(recherche)
                );
            });


        if (utilisateur) {

            activerActions(utilisateur);

        } else {

            desactiverActions();

            message.textContent =
                'Aucun utilisateur correspondant à cette recherche.';

        }

    }


    searchInput.addEventListener(
        'input',
        rechercherUtilisateur
    );


    /*
     * Confirmation avant suppression.
     */
    deleteButton.addEventListener(
        'click',
        function (event) {

            if (
                deleteButton.classList.contains('disabled')
            ) {
                event.preventDefault();
                return;
            }

            const confirmation =
                confirm(
                    'Supprimer cet utilisateur ?'
                );

            if (!confirmation) {
                event.preventDefault();
            }

        }
    );


    /*
     * État initial.
     */
    desactiverActions();

});
</script>

<?php endif; ?>