        'id' => $item['id_type_equipement'] ?? null,
    ])
    : $this->url('type_equipement', [
        'action' => 'add',
    ]);
?>

<div class="dashboard">

    <div class="dashboard-title">
        <div>

            

            <h1>
                <?= $mode === 'modification'
                    ? 'Modifier le type d’équipement'
                    : 'Ajouter un type d’équipement'
                ?>
            </h1>

            <p>
                <?= $mode === 'modification'
                    ? 'Modifiez le type d’équipement.'
                    : 'Enregistrez un nouveau type d’équipement.'
                ?>
            </p>

        </div>
    </div>

    <div class="dashboard-panel form-panel">

        <div class="form-card">

            <div class="form-card-header">

                <div class="form-card-icon">
                    
                </div>

                <div>
                    <h5>équipement</h5>

                </div>

            </div>

            <?php if ($erreur): ?>

                <div class="auth-error form-error">
                    <?= $this->escapeHtml($erreur) ?>
                </div>

            <?php endif; ?>

            <form
                method="post"
                action="<?= $action ?>"
                class="ibs-form"
            >

                <div class="auth-field">

                    <label for="nom_type">
                        Nom de l'équipement
                    </label>

                    <input
