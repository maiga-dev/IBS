<?php if (!empty($familles)): ?>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('searchFamilles');
    const rows = Array.from(
        document.querySelectorAll('#tableFamilles tbody tr')
    );

    function normaliser(texte) {
        return String(texte || '')
            .toLocaleLowerCase('fr-FR')
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '');
    }

    function rechercher() {
        const recherche = normaliser(searchInput.value.trim());

        rows.forEach(function (row) {
            const contenu = normaliser(row.textContent);
            row.style.display =
                recherche === '' || contenu.includes(recherche)
                    ? ''
                    : 'none';
        });
    }

    searchInput.addEventListener('input', rechercher);
});
</script>
<?php endif; ?>
