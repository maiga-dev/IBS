<?php
/** @var Laminas\View\Renderer\PhpRenderer $this */
$erreur = $erreur ?? null;
$item = $item ?? ['nom_famille' => ''];
$mode = $mode ?? 'ajout';
$action = $mode === 'modification'
    ? $this->url('famille', ['action' => 'edit', 'id' => $item['id_famille'] ?? null])
    : $this->url('famille', ['action' => 'add']);
?>
<div class="dashboard">
    <div class="dashboard-title">
        <div>
             <a href="<?= $this->url('famille') ?>" class="panel-link" style="display:inline-block;margin-bottom:8px;">← Retour à la liste</a>
            <h1><?= $mode === 'modification' ? 'Modifier la famille' : 'Ajouter une famille' ?></h1>
        </div>
    </div>

    <div class="dashboard-panel" style="max-width:480px;">
        <?php if ($erreur): ?>
            <div class="auth-error"><?= $this->escapeHtml($erreur) ?></div>
        <?php endif; ?>

        <form method="post" action="<?= $action ?>">
            <div class="auth-field">
                <label for="nom_famille">Nom de la famille</label>
                <input type="text" id="nom_famille" name="nom_famille"
                       value="<?= $this->escapeHtmlAttr($item['nom_famille'] ?? '') ?>" required autofocus>
            </div>
            <button type="submit" class="auth-submit">Enregistrer</button>
        </form>
    </div>
</div>
