<?php
/** @var Laminas\View\Renderer\PhpRenderer $this */

$this->headTitle('Maintenances et rapports');

$maintenances = $maintenances ?? [];

$echapper = fn ($valeur): string =>
    $this->escapeHtml((string) ($valeur ?? '—'));

$nombre = fn ($valeur): string =>
    number_format((int) ($valeur ?? 0), 0, ',', ' ');


$statutNormalise = static function ($statut): string {
    $statut = mb_strtolower(trim((string) $statut));

    $statut = str_replace(
        ['é', 'è', 'ê', 'à', ' '],
        ['e', 'e', 'e', 'a', '_'],
        $statut
    );

    return $statut !== '' ? $statut : 'non_renseigne';
};


$statutLibelle = static function ($statut): string {
    $statut = trim((string) $statut);

    return $statut !== '' ? ucfirst($statut) : 'Non renseigné';
};


$statutClasse = static function ($statut) use ($statutNormalise): string {
    return match ($statutNormalise($statut)) {
        'terminee', 'termine' => 'is-terminee',
        'en_cours' => 'is-en-cours',
        'planifiee', 'planifie' => 'is-planifiee',
        'affectee', 'affecte' => 'is-affectee',
        'suspendue', 'suspendu' => 'is-suspendue',
        'arretee', 'arrete' => 'is-arretee',
        default => 'is-inconnu',
    };
};

$compteRenduDisponible = static function (array $maintenance): bool {
    return trim((string) ($maintenance['compte_rendu'] ?? '')) !== ''
        || trim((string) ($maintenance['diagnostic_final'] ?? '')) !== '';
};


$urlDocument = function ($chemin): string {
    $chemin = trim((string) $chemin);

    if ($chemin === '') {
        return '';
    }

    if (preg_match('~^https?://~i', $chemin)) {
        return $chemin;
    }

    $chemin = str_replace('\\', '/', $chemin);
    $chemin = '/' . ltrim($chemin, '/');

    return $this->basePath($chemin);
};


$nombreRapports = count(array_filter(
    $maintenances,
    $compteRenduDisponible
));

$statuts = [];

foreach ($maintenances as $maintenance) {
    $libelle = $statutLibelle($maintenance['statut'] ?? null);
    $statuts[$libelle] = ($statuts[$libelle] ?? 0) + 1;
}
