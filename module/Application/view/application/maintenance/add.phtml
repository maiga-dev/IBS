<script>
document.addEventListener('DOMContentLoaded', function () {

    const paysData = <?= json_encode(
        $pays,
        JSON_HEX_TAG
        | JSON_HEX_APOS
        | JSON_HEX_QUOT
        | JSON_HEX_AMP
    ) ?>;

    const villesData = <?= json_encode(
        $villes,
        JSON_HEX_TAG
        | JSON_HEX_APOS
        | JSON_HEX_QUOT
        | JSON_HEX_AMP
    ) ?>;

    const sitesData = <?= json_encode(
        $sites,
        JSON_HEX_TAG
        | JSON_HEX_APOS
        | JSON_HEX_QUOT
        | JSON_HEX_AMP
    ) ?>;

    const centralesData = <?= json_encode(
        $centrales,
        JSON_HEX_TAG
        | JSON_HEX_APOS
        | JSON_HEX_QUOT
        | JSON_HEX_AMP
    ) ?>;

    const pays = document.getElementById('id_pays');
    const ville = document.getElementById('id_ville');
    const site = document.getElementById('id_site');
    const centrale = document.getElementById('id_centrale');

    const selectedCentrale =
        <?= json_encode($selectedCentrale) ?>;

    function resetSelect(select, placeholder) {

        select.innerHTML = '';

        select.appendChild(
            new Option(
                placeholder,
                ''
            )
        );

        select.disabled = true;
    }

    function remplirSelect(
        select,
        rows,
        valueKey,
        labelKey,
        placeholder,
        selectedValue = ''
    ) {

        select.innerHTML = '';

        select.appendChild(
            new Option(
                placeholder,
                ''
            )
        );

        const valeurs = new Set();

        rows.forEach(function (row) {

            const value = String(
                row[valueKey] ?? ''
            );

            const label = String(
                row[labelKey] ?? ''
            );

            if (!value || valeurs.has(value)) {
                return;
            }

            valeurs.add(value);

            const option = new Option(
                label,
                value
            );

            if (
                selectedValue !== ''
                && value === String(selectedValue)
            ) {
                option.selected = true;
            }

            select.appendChild(option);
        });

        select.disabled =
            select.options.length <= 1;
    }

    function chargerVilles(
        idPays,
        selectedVille = '',
        selectedSite = '',
        selectedIdCentrale = ''
    ) {

        resetSelect(
            ville,
            'Sélectionner une ville'
        );

        resetSelect(
            site,
            'Sélectionner un site'
        );

        resetSelect(
            centrale,
            'Sélectionner une centrale'
        );

        if (!idPays) {
            return;
        }

        const rows = villesData.filter(function (row) {

            return String(
                row.id_pays ?? ''
            ) === String(idPays);

        });

        remplirSelect(
            ville,
            rows,
            'id_ville',
            'nom_ville',
            'Sélectionner une ville',
            selectedVille
        );

        if (selectedVille) {

            chargerSites(
                selectedVille,
                selectedSite,
                selectedIdCentrale
            );
        }
    }

    function chargerSites(
        idVille,
        selectedSite = '',
        selectedIdCentrale = ''
    ) {

        resetSelect(
            site,
            'Sélectionner un site'
        );

        resetSelect(
            centrale,
            'Sélectionner une centrale'
        );

        if (!idVille) {
            return;
        }

        const rows = sitesData.filter(function (row) {

            return String(
                row.id_ville ?? ''
            ) === String(idVille);

        });

        remplirSelect(
            site,
            rows,
            'id_site',
            'nom_site',
            'Sélectionner un site',
            selectedSite
        );

        if (selectedSite) {

            chargerCentrales(
                selectedSite,
                selectedIdCentrale
            );
        }
    }

    function chargerCentrales(
        idSite,
        selectedIdCentrale = ''
    ) {

        resetSelect(
            centrale,
            'Sélectionner une centrale'
        );

        if (!idSite) {
            return;
        }

        const rows = centralesData.filter(function (row) {

            return String(
                row.id_site ?? ''
            ) === String(idSite);

        });

        remplirSelect(
            centrale,
            rows,
            'id_centrale',
            'type_centrale',
            'Sélectionner une centrale',
            selectedIdCentrale
        );
    }

    pays.addEventListener('change', function () {

        chargerVilles(
            this.value
        );

    });

    ville.addEventListener('change', function () {

        chargerSites(
            this.value
        );

    });

    site.addEventListener('change', function () {

        chargerCentrales(
            this.value
        );

    });

    /*
     * Restauration automatique après une erreur
     * de validation du formulaire.
     */
    if (selectedCentrale) {

        const centraleSelectionnee =
            centralesData.find(function (row) {

                return String(
                    row.id_centrale ?? ''
                ) === String(selectedCentrale);

            });

        if (centraleSelectionnee) {

            const idPays = String(
                centraleSelectionnee.id_pays ?? ''
            );

            const idVille = String(
                centraleSelectionnee.id_ville ?? ''
            );

            const idSite = String(
                centraleSelectionnee.id_site ?? ''
            );

            pays.value = idPays;

            chargerVilles(
                idPays,
                idVille,
                idSite,
                selectedCentrale
            );
        }
    }

});
</script>