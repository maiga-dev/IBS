<?php
/** @var Laminas\View\Renderer\PhpRenderer $this */
$centrales = $centrales ?? [];
$erreurs = $erreurs ?? [];
$idPreselectionnee = $id_centrale_preselectionnee ?? 0;
$csrfToken = $csrf_token ?? '';
$selectStyle = "width:100%;padding:10px 12px;border:1px solid #E7E9EC;border-radius:8px;font-family:'Inter',sans-serif;font-size:14px;";
?>
<div class="dashboard">
    <div class="dashboard-title">
        <div>
            <a href="<?= $this->url('maintenance') ?>" class="panel-link" style="display:inline-block;margin-bottom:8px;">← Retour à la liste</a>
            <h1>Nouvelle session de maintenance</h1>
            <p>Une ligne de maintenance sera créée automatiquement pour chaque équipement de la centrale choisie.</p>
        </div>
    </div>

    <div class="dashboard-panel" style="max-width:520px;">
        <?php if (! empty($erreurs)): ?>
            <div class="auth-error">
                <?php foreach ($erreurs as $e): ?>
                    <?= $this->escapeHtml($e) ?><br>
                <?php endforeach; ?>
            </div>
        <?php endif; ?>

        <form method="post" action="<?= $this->url('maintenance', ['action' => 'add']) ?>">
            <input type="hidden" name="csrf_token" value="<?= $this->escapeHtmlAttr($csrfToken) ?>">

            <div class="auth-field">
                <label for="id_centrale">Centrale</label>
                <select id="id_centrale" name="id_centrale" required style="<?= $selectStyle ?>">
                    <option value="">— Sélectionner —</option>
                    <?php foreach ($centrales as $c): ?>
                        <option value="<?= (int) $c['id_centrale'] ?>"
                            <?= $idPreselectionnee === (int) $c['id_centrale'] ? 'selected' : '' ?>>
                            <?= $this->escapeHtml((string) ($c['type_centrale'] ?? ('Centrale #' . $c['id_centrale']))) ?>
                            <?= $c['nom_site'] ? ' — ' . $this->escapeHtml($c['nom_site']) : '' ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </div>

            <div class="auth-field">
                <label for="date_session">Date de la visite</label>
                <input type="date" id="date_session" name="date_session" value="<?= date('Y-m-d') ?>" required>
            </div>

            <button type="submit" class="auth-submit">Créer la session</button>
        </form>
    </div>
</div>
