<script>
document.addEventListener('DOMContentLoaded', function () {

    /*
     * Agrandissement automatique des textarea.
     */
    const textareas = document.querySelectorAll(
        '.maintenance-action-page textarea'
    );

    textareas.forEach(function (textarea) {

        function autoResize() {

            textarea.style.height = 'auto';

            textarea.style.height =
                textarea.scrollHeight + 'px';
        }

        textarea.addEventListener(
            'input',
            autoResize
        );

        autoResize();

    });


    /*
     * Affichage du nom du fichier sélectionné.
     */
    const fichier = document.getElementById(
        'fichier'
    );

    const fichierNom = document.getElementById(
        'maintenance-file-name'
    );


    if (fichier && fichierNom) {

        fichier.addEventListener(
            'change',
            function () {

                if (
                    this.files &&
                    this.files.length > 0
                ) {

                    fichierNom.textContent =
                        this.files[0].name;

                } else {

                    fichierNom.textContent =
                        'PDF, JPG, PNG ou WEBP — 10 Mo maximum';

                }

            }
        );

    }

});
</script>