<?php
/** @var Laminas\View\Renderer\PhpRenderer $this */
$session = $session ?? [];
$equipements = $equipements ?? [];

$libellesStatut = [
    'planifiee' => 'Planifiée', 'en_cours' => 'En cours', 'suspendue' => 'Suspendue',
    'arretee' => 'Arrêtée', 'terminee' => 'Terminée',
];
?>
<div class="dashboard">
    <div class="dashboard-title">
        <div>
            <a href="<?= $this->url('maintenance', ['action' => 'detail', 'id' => $session['id_session']]) ?>" class="panel-link" style="display:inline-block;margin-bottom:8px;">← Retour à la session</a>
            <h1>Rapport — Session #<?= (int) $session['id_session'] ?></h1>
            <p>
                <?= $this->escapeHtml((string) ($session['type_centrale'] ?? '—')) ?>
                <?= $session['nom_site'] ? ' — ' . $this->escapeHtml($session['nom_site']) : '' ?>
                · <?= $this->escapeHtml(date('d/m/Y', strtotime($session['date_session']))) ?>
                <?= $session['technicien_nom'] ? ' · Technicien : ' . $this->escapeHtml($session['technicien_prenom'] . ' ' . $session['technicien_nom']) : '' ?>
            </p>
        </div>
        <button onclick="window.print()" class="auth-submit" style="width:auto;padding:10px 18px;">Imprimer / PDF</button>
    </div>

    <div class="dashboard-panel">
        <?php foreach ($equipements as $eq): ?>
            <?php $nomEquipement = trim(($eq['marque'] ?? '') . ' ' . ($eq['modele'] ?? '')) ?: $eq['type_equipement']; ?>
            <div style="border-bottom:1px solid #E7E9EC;padding:14px 0;">
                <strong><?= $this->escapeHtml($nomEquipement) ?></strong>
                — <span class="status"><?= $this->escapeHtml($libellesStatut[$eq['statut']] ?? $eq['statut']) ?></span>
                <p class="stat-description">N° série : <?= $this->escapeHtml((string) ($eq['numero_serie'] ?? '—')) ?></p>

                <?php if (! empty($eq['diagnostic'])): ?>
                    <p><b>Diagnostic :</b> <?= nl2br($this->escapeHtml($eq['diagnostic'])) ?></p>
                <?php endif; ?>

                <?php if (! empty($eq['compte_rendu'])): ?>
                    <p><b>Compte-rendu :</b> <?= nl2br($this->escapeHtml($eq['compte_rendu'])) ?></p>
                <?php endif; ?>

                <?php if ($eq['technicien_nom']): ?>
                    <p class="stat-description">Technicien : <?= $this->escapeHtml($eq['technicien_prenom'] . ' ' . $eq['technicien_nom']) ?></p>
                <?php endif; ?>
            </div>
        <?php endforeach; ?>
    </div>
</div>
