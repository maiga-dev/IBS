<script>
document.addEventListener('DOMContentLoaded', function () {

    const searchInput =
        document.getElementById('maintenanceSearch');

    const statusFilter =
        document.getElementById('maintenanceStatusFilter');

    const table =
        document.getElementById('tableMaintenances');

    const message =
        document.getElementById('maintenanceSearchMessage');

    const noResult =
        document.getElementById('maintenanceNoResult');

    if (!searchInput || !statusFilter || !table) {
        return;
    }

    const rows = Array.from(
        table.querySelectorAll('tbody tr')
    );

    function normaliser(texte) {
        return String(texte || '')
            .toLocaleLowerCase('fr-FR')
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '');
    }

    function filtrer() {

        const recherche = normaliser(
            searchInput.value.trim()
        );

        const statutRecherche = normaliser(
            statusFilter.value.trim()
        );

        let nombreVisible = 0;

        rows.forEach(function (row) {

            const contenu = normaliser(
                row.textContent
            );

            const rowStatus = normaliser(
                row.dataset.status || ''
            );

            const correspondRecherche =
                recherche === ''
                || contenu.includes(recherche);

            const correspondStatut =
                statutRecherche === ''
                || rowStatus === statutRecherche;

            const visible =
                correspondRecherche
                && correspondStatut;

            row.style.display =
                visible ? '' : 'none';

            if (visible) {
                nombreVisible++;
            }
        });

        if (noResult) {
            noResult.style.display =
                nombreVisible === 0 ? 'flex' : 'none';
        }

        if (message) {

            if (recherche === '' && statutRecherche === '') {
                message.textContent =
                    'La recherche porte sur toutes les informations affichées.';
            } else {
                message.textContent =
                    nombreVisible
                    + ' maintenance(s) correspondant aux critères.';
            }
        }
    }

    searchInput.addEventListener('input', filtrer);
    statusFilter.addEventListener('change', filtrer);
});
</script>
