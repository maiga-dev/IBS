<?php
/** @var Laminas\View\Renderer\PhpRenderer $this */
$sessions = $sessions ?? [];

$libellesStatut = [
    'planifiee' => 'Planifiée', 'en_cours' => 'En cours', 'suspendue' => 'Suspendue',
    'arretee' => 'Arrêtée', 'terminee' => 'Terminée',
];

// Compte par statut, pour afficher un nombre sur chaque bouton.
$compteurs = array_fill_keys(array_keys($libellesStatut), 0);
foreach ($sessions as $s) {
    if (isset($compteurs[$s['statut']])) {
        $compteurs[$s['statut']]++;
    }
}
?>
<div class="dashboard">
    <div class="dashboard-title">
        <div>
            <h1>Sessions de maintenance</h1>
            <p>Une session = une visite technicien sur une centrale, à une date.</p>
        </div>
        <a href="<?= $this->url('maintenance', ['action' => 'add']) ?>" class="auth-submit" style="width:auto;padding:10px 18px;text-decoration:none;display:inline-block;">
            + Nouvelle session
        </a>
    </div>

    <div class="dashboard-panel">

        <!-- FILTRES PAR STATUT -->
        <div id="filtres-statut" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
            <button type="button" class="filtre-btn actif" data-statut="tous" onclick="filtrerParStatut('tous', this)">
                Toutes <span class="filtre-count"><?= count($sessions) ?></span>
            </button>
            <?php foreach ($libellesStatut as $valeur => $libelle): ?>
                <button type="button" class="filtre-btn" data-statut="<?= $valeur ?>" onclick="filtrerParStatut('<?= $valeur ?>', this)">
                    <?= $this->escapeHtml($libelle) ?> <span class="filtre-count"><?= $compteurs[$valeur] ?></span>
                </button>
            <?php endforeach; ?>
        </div>

        <?php if (empty($sessions)): ?>
            <div class="empty-dashboard">
                <div class="empty-dashboard-icon">✓</div>
                <strong>Aucune session enregistrée</strong>
            </div>
        <?php else: ?>
            <div class="table-wrapper">
                <table class="ibs-table" id="table-sessions">
                    <thead>
                        <tr><th>Centrale</th><th>Site</th><th>Technicien</th><th>Avancement</th><th>Statut</th><th>Date</th><th></th></tr>
                    </thead>
                    <tbody>
                    <?php foreach ($sessions as $s): ?>
                        <tr data-statut="<?= $this->escapeHtmlAttr($s['statut']) ?>">
                            <td><?= $this->escapeHtml((string) ($s['type_centrale'] ?? '—')) ?></td>
                            <td><?= $this->escapeHtml((string) ($s['nom_site'] ?? '—')) ?></td>
                            <td><?= $s['technicien_nom'] ? $this->escapeHtml($s['technicien_prenom'] . ' ' . $s['technicien_nom']) : 'Non affecté' ?></td>
                            <td><?= (int) $s['nb_terminees'] ?> / <?= (int) $s['nb_equipements'] ?> équipements</td>
                            <td><span class="status"><?= $this->escapeHtml($libellesStatut[$s['statut']] ?? $s['statut']) ?></span></td>
                            <td class="date-cell"><?= $this->escapeHtml(date('d/m/Y', strtotime($s['date_session']))) ?></td>
                            <td style="text-align:right;white-space:nowrap;">
                                <a href="<?= $this->url('maintenance', ['action' => 'detail', 'id' => $s['id_session']]) ?>">Ouvrir</a>
                                &nbsp;·&nbsp;
                                <form method="post" action="<?= $this->url('maintenance', ['action' => 'delete', 'id' => $s['id_session']]) ?>"
                                      style="display:inline;"
                                      onsubmit="return confirm('Supprimer définitivement cette session et toutes ses maintenances ?');">
                                    <input type="hidden" name="csrf_token" value="<?= $this->escapeHtmlAttr($csrf_token ?? '') ?>">
                                    <button type="submit" style="background:none;border:none;color:#E94C3C;cursor:pointer;font-size:14px;padding:0;font-family:inherit;">Supprimer</button>
                                </form>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
            <p id="filtre-vide" class="stat-description" style="display:none;margin-top:12px;">
                Aucune session avec ce statut.
            </p>
        <?php endif; ?>
    </div>
</div>

<style>
.filtre-btn{
    padding:8px 14px;border:1px solid #E7E9EC;border-radius:20px;
    background:#fff;font-family:'Inter',sans-serif;font-size:13px;font-weight:600;
    cursor:pointer;color:#4B5563;
}
.filtre-btn .filtre-count{color:#64748B;font-weight:500;}
.filtre-btn.actif{background:#2E6A50;border-color:#2E6A50;color:#fff;}
.filtre-btn.actif .filtre-count{color:#EAF3EF;}
</style>

<script>
function filtrerParStatut(statut, bouton) {
    document.querySelectorAll('#filtres-statut .filtre-btn').forEach(function (b) {
        b.classList.remove('actif');
    });
    bouton.classList.add('actif');

    let visibles = 0;
    document.querySelectorAll('#table-sessions tbody tr').forEach(function (ligne) {
        const correspond = statut === 'tous' || ligne.dataset.statut === statut;
        ligne.style.display = correspond ? '' : 'none';
        if (correspond) visibles++;
    });

    const messageVide = document.getElementById('filtre-vide');
    if (messageVide) {
        messageVide.style.display = visibles === 0 ? 'block' : 'none';
    }
}
</script>
