<!-- ============================================================
     JAVASCRIPT
============================================================ -->

<script>

(() => {

    const tableBody =
        document.getElementById('maintenance-table-body');

    const noResult =
        document.getElementById('no-maintenance-result');

    const activeFilter =
        document.getElementById('active-filter');

    const activeFilterText =
        document.getElementById('active-filter-text');

    const clearFilter =
        document.getElementById('clear-filter');


    if (!tableBody) {
        return;
    }


    /*
     * ------------------------------------------------------------
     * ÉTAT DES FILTRES
     * ------------------------------------------------------------
     */

    const state = {
        pays: '',
        ville: '',
        site: '',
        centrale: ''
    };


    const labels = {
        pays: 'Pays',
        ville: 'Ville',
        site: 'Site',
        centrale: 'Centrale'
    };


    const ordre = [
        'pays',
        'ville',
        'site',
        'centrale'
    ];


    /*
     * ------------------------------------------------------------
     * NORMALISATION
     * ------------------------------------------------------------
     */

    function normaliser(value) {

        return String(value || '')
            .toLocaleLowerCase('fr-FR')
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .trim();

    }


    /*
     * ------------------------------------------------------------
     * LIGNES DU TABLEAU
     * ------------------------------------------------------------
     */

    function rows() {

        return Array.from(
            tableBody.querySelectorAll(
                'tr[data-pays]'
            )
        );

    }


    /*
     * ------------------------------------------------------------
     * UNE LIGNE CORRESPOND-ELLE AUX FILTRES ?
     * ------------------------------------------------------------
     */

    function ligneCorrespond(ligne) {

        return ordre.every((niveau) => {

            const filtre =
                normaliser(state[niveau]);

            if (!filtre) {
                return true;
            }

            return (
                normaliser(
                    ligne.dataset[niveau]
                ) === filtre
            );

        });

    }


    /*
     * ------------------------------------------------------------
     * APPLICATION DES FILTRES
     * ------------------------------------------------------------
     */

    function appliquerFiltres() {

        let nombreVisible = 0;


        rows().forEach((ligne) => {

            const visible =
                ligneCorrespond(ligne);

            ligne.hidden = !visible;

            if (visible) {
                nombreVisible++;
            }

        });


        if (noResult) {

            noResult.hidden =
                nombreVisible !== 0;

        }


        afficherEtatActif();


        /*
         * Bouton "Tous"
         */

        const tousActif =
            ordre.every(
                (niveau) => !state[niveau]
            );


        const boutonTous =
            document.querySelector(
                '.filter-all'
            );


        if (boutonTous) {

            boutonTous.classList.toggle(
                'active',
                tousActif
            );

        }


        /*
         * Boutons des filtres
         */

        document
            .querySelectorAll(
                '.filter-title:not(.filter-all)'
            )
            .forEach((button) => {

                const niveau =
                    button.dataset.filter;

                button.classList.toggle(
                    'active',
                    Boolean(state[niveau])
                );

            });

    }


    /*
     * ------------------------------------------------------------
     * AFFICHAGE DU FILTRE ACTIF
     * ------------------------------------------------------------
     */

    function afficherEtatActif() {

        if (
            !activeFilter ||
            !activeFilterText
        ) {
            return;
        }


        const actifs =
            ordre
                .filter(
                    (niveau) =>
                        state[niveau] !== ''
                )
                .map(
                    (niveau) =>
                        labels[niveau]
                        + ' : '
                        + state[niveau]
                );


        activeFilter.hidden =
            actifs.length === 0;


        activeFilterText.textContent =
            actifs.join(' · ');

    }


    /*
     * ------------------------------------------------------------
     * OUVERTURE / FERMETURE DES FILTRES
     * ------------------------------------------------------------
     */

    document
        .querySelectorAll('.filter-title')
        .forEach((button) => {

            button.addEventListener(
                'click',
                function () {

                    const niveau =
                        this.dataset.filter;


                    /*
                     * TOUS
                     */

                    if (niveau === 'tous') {

                        ordre.forEach(
                            (key) => {
                                state[key] = '';
                            }
                        );


                        document
                            .querySelectorAll(
                                '.filter-group'
                            )
                            .forEach(
                                (group) => {
                                    group.classList
                                        .remove('open');
                                }
                            );


                        appliquerFiltres();

                        return;
                    }


                    const groupe =
                        this.closest(
                            '.filter-group'
                        );


                    /*
                     * Fermer les autres
                     */

                    document
                        .querySelectorAll(
                            '.filter-group'
                        )
                        .forEach(
                            (group) => {

                                if (
                                    group !== groupe
                                ) {

                                    group.classList
                                        .remove(
                                            'open'
                                        );

                                }

                            }
                        );


                    /*
                     * Ouvrir celui demandé
                     */

                    if (groupe) {

                        groupe.classList.toggle(
                            'open'
                        );

                    }

                }
            );

        });


    /*
     * ------------------------------------------------------------
     * CHOIX D'UNE OPTION
     * ------------------------------------------------------------
     */

    document.addEventListener(
        'click',
        function (event) {

            const option =
                event.target.closest(
                    '.filter-option'
                );


            if (!option) {
                return;
            }


            if (
                option.classList.contains(
                    'disabled'
                )
            ) {
                return;
            }


            const niveau =
                option.dataset.niveau;

            const valeur =
                option.dataset.valeur || '';


            if (!niveau) {
                return;
            }


            state[niveau] = valeur;


            /*
             * Hiérarchie :
             *
             * Pays
             *   ↓
             * Ville
             *   ↓
             * Site
             *   ↓
             * Centrale
             *
             * Lorsqu'on change un niveau,
             * les niveaux inférieurs sont remis à zéro.
             */

            const index =
                ordre.indexOf(niveau);


            if (index >= 0) {

                ordre
                    .slice(index + 1)
                    .forEach(
                        (key) => {
                            state[key] = '';
                        }
                    );

            }


            /*
             * Fermer les menus
             */

            document
                .querySelectorAll(
                    '.filter-group'
                )
                .forEach(
                    (group) => {
                        group.classList
                            .remove('open');
                    }
                );


            appliquerFiltres();

        }
    );


    /*
     * ------------------------------------------------------------
     * SUPPRIMER LES FILTRES
     * ------------------------------------------------------------
     */

    if (clearFilter) {

        clearFilter.addEventListener(
            'click',
            function () {

                ordre.forEach(
                    (key) => {
                        state[key] = '';
                    }
                );


                document
                    .querySelectorAll(
                        '.filter-group'
                    )
                    .forEach(
                        (group) => {
                            group.classList
                                .remove('open');
                        }
                    );


                appliquerFiltres();

            }
        );

    }


    /*
     * ------------------------------------------------------------
     * INITIALISATION
     * ------------------------------------------------------------
     */

    appliquerFiltres();

})();

</script>