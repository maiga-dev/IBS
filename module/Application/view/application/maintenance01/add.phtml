<?php
/** @var Laminas\View\Renderer\PhpRenderer $this */

$erreurs = $erreurs ?? [];
$centrales = $centrales ?? [];

$types = [
    'preventive' => 'Préventive',
    'curative' => 'Curative',
];

$selectStyle = "width:100%;padding:10px 12px;border:1px solid #E7E9EC;border-radius:8px;font-family:'Inter',sans-serif;font-size:14px;";
?>

<div class="dashboard">

    <div class="dashboard-title">
        <div>
            <a href="<?= $this->url('maintenance') ?>"
               class="panel-link"
               style="display:inline-block;margin-bottom:8px;">
                ← Retour à la liste
            </a>

            <h1>Nouvelle maintenance</h1>

            <p>
                L'hôpital a signalé un problème sur une centrale —
                1er diagnostic à la création.
            </p>
        </div>
    </div>

    <div class="dashboard-panel" style="max-width:560px;">

        <?php if (!empty($erreurs)): ?>

            <div class="auth-error">

                <?php foreach ($erreurs as $erreur): ?>

                    <div>
                        <?= $this->escapeHtml($erreur) ?>
                    </div>

                <?php endforeach; ?>

            </div>

        <?php endif; ?>


        <form method="post"
              action="<?= $this->url('maintenance', ['action' => 'add']) ?>">

            <!-- CSRF -->
            <input type="hidden"
                   name="csrf_token"
                   value="<?= $this->escapeHtmlAttr($csrf_token ?? '') ?>">


            <!-- CENTRALE -->
            <div class="auth-field">

                <label for="id_centrale">
                    Centrale concernée
                </label>

                <select
                    id="id_centrale"
                    name="id_centrale"
                    required
                    style="<?= $selectStyle ?>"
                >

                    <option value="">
                        — Sélectionner —
                    </option>

                    <?php foreach ($centrales as $c): ?>

                        <option
                            value="<?= (int) $c['id_centrale'] ?>"
                            <?= (
                                isset($id_centrale)
                                && (int) $id_centrale === (int) $c['id_centrale']
                            ) ? 'selected' : '' ?>
                        >

                            <?= $this->escapeHtml(
                                (string) (
                                    $c['type_centrale']
                                    ?? ('Centrale #' . $c['id_centrale'])
                                )
                            ) ?>

                            <?php if (!empty($c['nom_site'])): ?>

                                —
                                <?= $this->escapeHtml(
                                    (string) $c['nom_site']
                                ) ?>

                            <?php endif; ?>

                        </option>

                    <?php endforeach; ?>

                </select>

            </div>


            <!-- DATE + TYPE -->
            <div class="auth-row">

                <div class="auth-field">

                    <label for="date_maintenance">
                        Date
                    </label>

                    <input
                        type="date"
                        id="date_maintenance"
                        name="date_maintenance"
                        value="<?= $this->escapeHtmlAttr(
                            $date_maintenance
                            ?? date('Y-m-d')
                        ) ?>"
                        required
                    >

                </div>


                <div class="auth-field">

                    <label for="type_maintenance">
                        Type
                    </label>

                    <select
                        id="type_maintenance"
                        name="type_maintenance"
                        required
                        style="<?= $selectStyle ?>"
                    >

                        <?php foreach ($types as $value => $label): ?>

                            <option
                                value="<?= $this->escapeHtmlAttr($value) ?>"
                                <?= (
                                    ($type_maintenance ?? 'preventive')
                                    === $value
                                ) ? 'selected' : '' ?>
                            >
                                <?= $this->escapeHtml($label) ?>
                            </option>

                        <?php endforeach; ?>

                    </select>

                </div>

            </div>


            <!-- DIAGNOSTIC -->
            <div class="auth-field">

                <label for="diagnostic">
                    1er diagnostic
                </label>

                <textarea
                    id="diagnostic"
                    name="diagnostic"
                    rows="4"
                    required
                    style="<?= $selectStyle ?>"
                ><?= $this->escapeHtml(
                    $diagnostic ?? ''
                ) ?></textarea>

            </div>


            <button
                type="submit"
                class="auth-submit"
            >
                Créer la maintenance
            </button>

        </form>

    </div>

</div>
