<script>
function ouvrirRapport(id) {
    const element =
        document.getElementById('rapport-' + id);

    if (element) {
        element.style.display = 'block';
    }
}

function fermerRapport(id) {
    const element =
        document.getElementById('rapport-' + id);

    if (element) {
        element.style.display = 'none';
    }
}
</script>
