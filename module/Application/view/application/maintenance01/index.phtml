<?php
/** @var Laminas\View\Renderer\PhpRenderer $this */

$maintenances = $maintenances ?? [];

$statutSelectionne = $statut_selectionne ?? '';

$libellesStatut = [
    'planifiee' => 'Planifiée',
    'en_cours'  => 'En cours',
    'suspendue' => 'Suspendue',
    'arretee'   => 'Arrêtée',
    'terminee'  => 'Terminée',
];

$classesStatut = [
    'planifiee' => 'status-planifiee',
    'en_cours'  => 'status-en-cours',
    'suspendue' => 'status-default',
    'arretee'   => 'status-default',
    'terminee'  => 'status-terminee',
];
?>

<div class="dashboard">

    <!-- EN-TÊTE -->
    <div class="dashboard-title">
        <div>
            <h1>Maintenances</h1>
            <p>Suivi des interventions sur les équipements.</p>
        </div>

        <a
            href="<?= $this->url('maintenance', ['action' => 'add']) ?>"
            class="auth-submit"
            style="width:auto;padding:10px 18px;text-decoration:none;display:inline-block;"
        >
            + Nouvelle maintenance
        </a>
    </div>


    <!-- FILTRE -->
    <div class="dashboard-panel" style="margin-bottom:20px;">

        <form
            method="get"
            action="<?= $this->url('maintenance') ?>"
            style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;"
        >

            <label
                for="statut"
                style="font-weight:600;"
            >
                Filtrer par statut :
            </label>

            <select
                name="statut"
                id="statut"
                onchange="this.form.submit()"
                style="
                    padding:9px 14px;
                    border:1px solid #d1d5db;
                    border-radius:8px;
                    background:#fff;
                    min-width:190px;
                "
            >

                <option value="">
                    Toutes les maintenances
                </option>

                <?php foreach ($libellesStatut as $code => $libelle): ?>

                    <option
                        value="<?= $this->escapeHtmlAttr($code) ?>"
                        <?= $statutSelectionne === $code ? 'selected' : '' ?>
                    >
                        <?= $this->escapeHtml($libelle) ?>
                    </option>

                <?php endforeach; ?>

            </select>

            <?php if ($statutSelectionne !== ''): ?>

                <a
                    href="<?= $this->url('maintenance') ?>"
                    style="
                        padding:9px 14px;
                        text-decoration:none;
                        color:#6b7280;
                    "
                >
                    Réinitialiser
                </a>

            <?php endif; ?>

        </form>

    </div>


    <!-- LISTE -->
    <div class="dashboard-panel">

        <?php if (empty($maintenances)): ?>

            <div class="empty-dashboard">

                <div class="empty-dashboard-icon">
                    ✓
                </div>

                <strong>
                    <?php if ($statutSelectionne !== ''): ?>

                        Aucune maintenance
                        « <?= $this->escapeHtml(
                            $libellesStatut[$statutSelectionne]
                            ?? $statutSelectionne
                        ) ?> »

                    <?php else: ?>

                        Aucune maintenance enregistrée

                    <?php endif; ?>
                </strong>

            </div>

        <?php else: ?>

            <div class="table-wrapper">

                <table class="ibs-table">

                    <thead>
                        <tr>
                            <th>Centrale</th>
                            <th>Site</th>
                            <th>Équipement</th>
                            <th>Technicien</th>
                            <th>Type</th>
                            <th>Statut</th>
                            <th>Date</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                    <?php foreach ($maintenances as $m): ?>

                        <?php
                        $statut = (string) ($m['statut'] ?? '');

                        $technicien = 'Non affecté';

                        if (
                            !empty($m['technicien_nom'])
                            || !empty($m['technicien_prenom'])
                        ) {
                            $technicien =
                                trim(
                                    ($m['technicien_prenom'] ?? '')
                                    . ' '
                                    . ($m['technicien_nom'] ?? '')
                                );
                        }

                        $dateMaintenance = '—';

                        if (!empty($m['date_maintenance'])) {
                            $timestamp = strtotime(
                                (string) $m['date_maintenance']
                            );

                            if ($timestamp !== false) {
                                $dateMaintenance =
                                    date('d/m/Y', $timestamp);
                            }
                        }
                        ?>

                        <tr>

                            <!-- CENTRALE -->
                            <td>
                                <?= $this->escapeHtml(
                                    (string) (
                                        $m['type_centrale']
                                        ?? '—'
                                    )
                                ) ?>
                            </td>

                            <!-- SITE -->
                            <td>
                                <?= $this->escapeHtml(
                                    (string) (
                                        $m['nom_site']
                                        ?? '—'
                                    )
                                ) ?>
                            </td>

                            <!-- EQUIPEMENT -->
                            <td>
                                <?php
                                $equipement = $m['type_equipement'] ?? null;
                                ?>

                                <?= $this->escapeHtml(
                                    (string) (
                                        $equipement
                                        ?: '—'
                                    )
                                ) ?>

                                <?php if (!empty($m['numero_serie'])): ?>

                                    <br>

                                    <small
                                        style="color:#6b7280;"
                                    >
                                        SN :
                                        <?= $this->escapeHtml(
                                            (string) $m['numero_serie']
                                        ) ?>
                                    </small>

                                <?php endif; ?>
                            </td>

                            <!-- TECHNICIEN -->
                            <td>
                                <?= $this->escapeHtml(
                                    $technicien
                                ) ?>
                            </td>

                            <!-- TYPE -->
                            <td>
                                <?= $this->escapeHtml(
                                    ucfirst(
                                        (string) (
                                            $m['type_maintenance']
                                            ?? '—'
                                        )
                                    )
                                ) ?>
                            </td>

                            <!-- STATUT -->
                            <td>

                                <span
                                    class="status <?= $classesStatut[$statut] ?? 'status-default' ?>"
                                >
                                    <?= $this->escapeHtml(
                                        $libellesStatut[$statut]
                                        ?? $statut
                                    ) ?>
                                </span>

                            </td>

                            <!-- DATE -->
                            <td class="date-cell">
                                <?= $this->escapeHtml(
                                    $dateMaintenance
                                ) ?>
                            </td>

                            <!-- ACTION -->
                            <td style="text-align:right;">

                                <a
                                    href="<?= $this->url(
                                        'maintenance',
                                        [
                                            'action' => 'view',
                                            'id' => $m['id_maintenance']
                                        ]
                                    ) ?>"
                                >
                                    Ouvrir
                                </a>

                            </td>

                        </tr>

                    <?php endforeach; ?>

                    </tbody>

                </table>

            </div>

        <?php endif; ?>

    </div>

</div>
